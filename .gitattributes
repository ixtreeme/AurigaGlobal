# Auto detect text files and perform LF normalization
* text=auto

# The spell catalog records a SHA-256 of these exact source bytes.
config/eclipse_raid_spells.json text eol=lf
SRC/Server/GameServer/raid/icc/SpellRecords.generated.hpp text eol=lf

# Generated by SRC/Tools/ItemCatalogBuilder; the build's --check compares
# these exact bytes, so a CRLF checkout would fail it.
SRC/Server/common/item/ItemCategory.hpp text eol=lf
SRC/Server/common/item/BonusRegistry.hpp text eol=lf
db/migrations/item_combat/002_category_seed.sql text eol=lf
db/migrations/item_combat/007_bonus_registry_seed.sql text eol=lf
