<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-generated by CMake - do not edit manually -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <VcpkgHostTriplet>x64-windows</VcpkgHostTriplet>
    <VcpkgUseStatic>false</VcpkgUseStatic>
    <VcpkgConfiguration>$(Configuration)</VcpkgConfiguration>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
    <VcpkgRoot>C:/vcpkg</VcpkgRoot>
  </PropertyGroup>

  <!-- Security hardening - all projects -->
  <ItemDefinitionGroup>
    <ClCompile>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <SDLCheck>true</SDLCheck>
      <SpectreMitigation>Spectre</SpectreMitigation>
      <ControlFlowGuard Condition="'ON'!='ON'">Guard</ControlFlowGuard>
      <ControlFlowGuard Condition="'ON'=='ON'">false</ControlFlowGuard>
    </ClCompile>
    <Link>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <HighEntropyVA>true</HighEntropyVA>
      <ImageHasSafeExceptionHandlers>true</ImageHasSafeExceptionHandlers>
    </Link>
  </ItemDefinitionGroup>

  <!-- RTC1: Debug only, not with ASAN -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' And 'ON'!='ON'">
    <ClCompile>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- RuntimeLibrary + LTCG: normal build -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' And 'ON'!='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary></ClCompile>
    <Link><LinkTimeCodeGeneration>UseFastLinkTimeCodeGeneration</LinkTimeCodeGeneration></Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' And 'ON'!='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='RelWithDebInfo' And 'ON'!='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary></ClCompile>
    <Link><LinkTimeCodeGeneration>UseFastLinkTimeCodeGeneration</LinkTimeCodeGeneration></Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='MinSizeRel' And 'ON'!='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary></ClCompile>
    <Link><LinkTimeCodeGeneration>UseFastLinkTimeCodeGeneration</LinkTimeCodeGeneration></Link>
  </ItemDefinitionGroup>

  <!-- RuntimeLibrary: ASAN build - DLL CRT required, no LTCG -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' And 'ON'=='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' And 'ON'=='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='RelWithDebInfo' And 'ON'=='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='MinSizeRel' And 'ON'=='ON'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary></ClCompile>
  </ItemDefinitionGroup>

</Project>
