{
  "schema_version": 1,
  "common": {
    "locale": "utf8mb4",
    "table_postfix": "",
    "interserver_key": "REPLACE_WITH_YOUR_SHARED_KEY",
    "sql": {
      "player": {"host": "127.0.0.1", "port": 3306, "user": "auriga", "password": "REPLACE_ME", "database": "player"},
      "account": {"host": "127.0.0.1", "port": 3306, "user": "auriga", "password": "REPLACE_ME", "database": "account"},
      "common": {"host": "127.0.0.1", "port": 3306, "user": "auriga", "password": "REPLACE_ME", "database": "common"},
      "log": {"host": "127.0.0.1", "port": 3306, "user": "auriga", "password": "REPLACE_ME", "database": "log"},
      "mission": {"host": "127.0.0.1", "port": 3306, "user": "auriga", "password": "REPLACE_ME", "database": "mission"}
    },
    "tls": {"cert_file": "tls/server.crt", "key_file": "tls/server.key"}
  },
  "database": {
    "working_directory": "run/database",
    "network": {"bind_ip": "127.0.0.1", "bind_port": 5300},
