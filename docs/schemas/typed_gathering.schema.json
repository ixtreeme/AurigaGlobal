{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed world gathering sites v1",
  "type": "object", "additionalProperties": false, "required": ["version", "sites"],
  "properties": {
    "version": {"const": 1},
    "sites": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/site"}}
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "site": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "map", "race", "name", "kind", "pool", "range", "duration_ms", "minimum_power", "power_step", "base_chance_bp", "power_chance_bp", "bait_chance_bp", "rewards"],
      "properties": {
        "id": {"$ref": "#/$defs/u32"}, "map": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "race": {"$ref": "#/$defs/u32"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128}, "kind": {"enum": [1, 2, 3, 4]}, "pool": {"enum": [1, 2, 3]},
        "range": {"type": "integer", "minimum": 1, "maximum": 1000}, "duration_ms": {"type": "integer", "minimum": 1000, "maximum": 120000},
        "minimum_power": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "power_step": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "base_chance_bp": {"$ref": "#/$defs/bp"}, "power_chance_bp": {"$ref": "#/$defs/bp"}, "bait_chance_bp": {"$ref": "#/$defs/bp"},
        "rewards": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["category", "local", "count", "weight"],
          "properties": {"category": {"type": "integer", "minimum": 1, "maximum": 18}, "local": {"$ref": "#/$defs/u32"}, "count": {"type": "integer", "minimum": 1, "maximum": 10000}, "weight": {"$ref": "#/$defs/u32"}}
        }}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": 2}}}, "then": {"properties": {"pool": {"enum": [2, 3]}}}, "else": {"properties": {"pool": {"const": 1}, "bait_chance_bp": {"const": 0}}}}]
    }
  }
}
