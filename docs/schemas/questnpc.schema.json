{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest NPC script directories",
  "type": "object",
  "additionalProperties": false,
  "required": ["npcs"],
  "properties": {
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vnum", "name"],
        "properties": {
          "vnum": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"const": "notarget"}}
        }
      },
      "$comment": "The server additionally requires unique vnums and unique names. The 0/notarget entry is generated by the runtime."
    }
  }
}
